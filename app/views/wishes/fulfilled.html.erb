<div style="max-width: 700px; margin: 40px auto; padding: 0 20px;">
  <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 30px;">
    <h1 style="font-size: 1.6rem; color: #ff80bf; margin: 0; font-weight: 800;">🏆 叶ったことリスト</h1>
    <%= link_to '← 叶えたいことリストへ', wishes_path, style: "border-radius: 20px; font-weight: 800; background: #fff0f7; color: #ff80bf; border: 1.5px solid #ffe6f2; padding: 8px 16px; text-decoration: none; font-size: 0.85rem;" %>
  </div>

  <% if @fulfilled_wishes.any? %>
    <% @fulfilled_wishes.each do |wish| %>
      <div style="margin-bottom: 25px; border-radius: 24px; border: 2.5px solid #a8edd9; box-shadow: 0 8px 24px rgba(168, 237, 217, 0.25); background: #ffffff; padding: 22px;">
        <% if wish.image.attached? %>
          <div style="margin-bottom: 15px; text-align: center;">
            <%= image_tag wish.image, style: "width: 100%; max-height: 220px; object-fit: cover; border-radius: 18px; border: 1.5px solid #a8edd9;" %>
          </div>
        <% end %>

        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 10px;">
          <div style="display: flex; align-items: center; gap: 10px;">
            <span style="background: #a8edd9; color: #2d6a57; font-weight: 800; font-size: 0.8rem; padding: 4px 10px; border-radius: 10px;">ACHIEVED!</span>
            <h2 style="margin: 0; font-size: 1.3rem;">
              <%= link_to wish.title, wish_path(wish), style: "color: #333; text-decoration: none; font-weight: 800;" %>
            </h2>
          </div>
          <%= button_to '未達成に戻す', toggle_fulfill_wish_path(wish), method: :patch, data: { turbo_confirm: "『#{wish.title}』を叶えたいリストに戻しますか？" }, style: "background: none; border: none; color: #aaa; text-decoration: underline; font-size: 0.8rem; cursor: pointer;" %>
        </div>

        <div style="font-size: 0.9rem; color: #8a7b8e; background: #f6fbf9; padding: 12px 16px; border-radius: 14px; margin-bottom: 15px;">
          🎉 <strong><%= wish.updated_at.strftime("%Y年%m月%d日") %></strong> に目標金額 <strong><%= number_to_currency(wish.target_amount, unit: "円", precision: 0, format: "%n%u") %></strong> を達成しました！
        </div>

        <!-- 🌸 ボタンエリア（画像保存 & Xシェア） -->
        <% 
          share_text = "『#{wish.title}』の目標貯金（#{number_to_currency(wish.target_amount, unit: '円', precision: 0, format: '%n%u')}）を達成しました！🎉✨ #ゆめかわ貯金 #願い事達成"
          tweet_url = "https://twitter.com/intent/tweet?text=#{CGI.escape(share_text)}"
        %>
        <div style="display: flex; justify-content: flex-end; gap: 10px; flex-wrap: wrap;">
          <% if wish.image.attached? %>
            <%= link_to rails_blob_path(wish.image, disposition: "attachment"), style: "display: inline-flex; align-items: center; gap: 6px; border-radius: 16px; font-weight: 800; background: #fff0f7; color: #ff80bf; border: 1.5px solid #ffe6f2; padding: 8px 16px; text-decoration: none; font-size: 0.85rem;" do %>
              <span>画像を保存</span>
            <% end %>
          <% end %>

          <%= link_to tweet_url, target: '_blank', rel: 'noopener noreferrer', style: "display: inline-flex; align-items: center; gap: 6px; border-radius: 16px; font-weight: 800; background: #1da1f2; color: #ffffff; padding: 8px 16px; text-decoration: none; font-size: 0.85rem; box-shadow: 0 4px 10px rgba(29, 161, 242, 0.3);" do %>
            <span>Xで達成をシェア</span>
          <% end %>
        </div>

      </div>
    <% end %>
  <% else %>
    <div style="text-align: center; padding: 60px 0; color: #8a7b8e;">
      <p style="font-size: 1.2rem; font-weight: 800; color: #ff80bf;">まだ叶ったことリストアイテムがありません</p>
      <p style="font-size: 0.9rem;">目標を100%まで貯金して「達成した！」ボタンを押すと、ここに飾られます！</p>
    </div>
  <% end %>
</div>