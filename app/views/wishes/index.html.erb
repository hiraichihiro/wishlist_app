<div style="max-width: 700px; margin: 40px auto; padding: 0 20px;">
  <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 25px;">
    <h1 style="font-size: 1.6rem; color: #ff80bf; margin: 0; font-weight: 800;">💌 叶えたいこと・欲しいもの</h1>
    <div style="display: flex; gap: 10px;">
      <%= link_to '🏆 叶ったことリスト', fulfilled_wishes_path, style: "border-radius: 20px; font-weight: 800; background: #fff0f7; color: #ff80bf; border: 1.5px solid #ffe6f2; padding: 8px 16px; text-decoration: none; font-size: 0.85rem;" %>
      <%= link_to '＋ 新しく登録', new_wish_path, style: "border-radius: 20px; font-weight: 800; background: #ffb3d9; color: #ffffff; padding: 8px 18px; text-decoration: none; box-shadow: 0 4px 12px rgba(255, 179, 217, 0.4); font-size: 0.85rem;" %>
    </div>
  </div>

  <% if @wishes.any? %>
    <% @wishes.each do |wish| %>
      <div style="margin-bottom: 25px; border-radius: 24px; border: 2.5px solid #ffe6f2; box-shadow: 0 8px 24px rgba(255, 179, 217, 0.2); background: #ffffff; padding: 22px;">
        <% if wish.image.attached? %>
          <div style="margin-bottom: 15px; text-align: center;">
            <%= image_tag wish.image, style: "width: 100%; max-height: 220px; object-fit: cover; border-radius: 18px; border: 1.5px solid #ffe6f2;" %>
          </div>
        <% end %>

        <div style="display: flex; justify-content: space-between; align-items: baseline;">
          <h2 style="margin: 0; font-size: 1.3rem;">
            <%= link_to wish.title, wish_path(wish), style: "color: #ff80bf; text-decoration: none; font-weight: 800;" %>
          </h2>
          <span style="border-radius: 12px; padding: 4px 12px; font-size: 0.8rem; background: #fff0f7; color: #ff80bf; font-weight: 700;">
            あと <%= number_to_currency(wish.remaining_amount, unit: "円", precision: 0, format: "%n%u") %>
          </span>
        </div>

        <div style="margin: 15px 0 8px 0; display: flex; justify-content: space-between; font-size: 0.9rem; color: #8a7b8e;">
          <span>貯金額: <strong style="color: #70d6ff;"><%= number_to_currency(wish.total_saved, unit: "円", precision: 0, format: "%n%u") %></strong></span>
          <span>目標: <%= number_to_currency(wish.target_amount, unit: "円", precision: 0, format: "%n%u") %> (<%= wish.progress_percentage %>%)</span>
        </div>

        <div style="background-color: #fafafa; border-radius: 10px; height: 14px; width: 100%; overflow: hidden; padding: 2px; border: 1px solid #f0f0f0;">
          <div style="background: linear-gradient(90deg, #a8edd9 0%, #b8e994 30%, #74b9ff 60%, #ffc4d6 100%); height: 100%; width: <%= wish.progress_percentage %>%; border-radius: 8px; transition: width 0.5s;"></div>
        </div>

        <%# 🌸 日割り計算の表示エリア %>
        <% if wish.daily_savings_target %>
          <div style="margin-top: 12px; font-size: 0.85rem; color: #ff80bf; background: #fff0f7; padding: 8px 12px; border-radius: 12px; text-align: center; font-weight: 700;">
            ⏰ あと <%= wish.remaining_days %> 日！ 1日あたり <strong><%= number_to_currency(wish.daily_savings_target, unit: "円", precision: 0, format: "%n%u") %></strong> 節約で達成できるよ🌸
          </div>
        <% elsif wish.remaining_days && wish.remaining_days <= 0 && wish.progress_percentage < 100 %>
          <div style="margin-top: 12px; font-size: 0.85rem; color: #ff6b6b; background: #ffe3e3; padding: 8px 12px; border-radius: 12px; text-align: center; font-weight: 700;">
            ⚠️ 目標期日を過ぎています。マイペースに頑張りましょう！
          </div>
        <% end %>

        <% if wish.progress_percentage >= 100 %>
          <div style="margin-top: 15px; text-align: center;">
            <%= button_to '🎉 達成した！リストへ移動', toggle_fulfill_wish_path(wish), method: :patch, style: "width: 100%; border-radius: 16px; font-weight: 800; background: #a8edd9; color: #2d6a57; padding: 10px; border: none; cursor: pointer; box-shadow: 0 4px 12px rgba(168, 237, 217, 0.5); font-family: inherit; font-size: 0.95rem;" %>
          </div>
        <% end %>
      </div>
    <% end %>
  <% else %>
    <div style="text-align: center; padding: 50px 0; color: #8a7b8e;">
      <p style="font-size: 1.1rem; font-weight: 700;">現在叶えたいリストは空っぽです🌸</p>
      <p style="font-size: 0.9rem;">「＋ 新しく登録」から新しい目標を追加してみてね！</p>
    </div>
  <% end %>
</div>